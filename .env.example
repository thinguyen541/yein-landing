# Copy this file to .env and change the values. Never commit .env.

# MySQL (Docker container)
MYSQL_ROOT_PASSWORD=change-me-root
DB_NAME=yein
DB_USER=yein
DB_PASSWORD=change-me-db
DB_HOST_PORT=3307

# Backend
# Generate a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# First admin account (only created when the admins table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

# Website port on the host
WEB_PORT=8080
CORS_ORIGIN=*
